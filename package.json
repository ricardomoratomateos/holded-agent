{
  "name": "holded-agent",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "dev:watch": "tsx watch --env-file=.env src/server.ts",
    "dev:docker": "tsx watch src/server.ts",
    "dev:docker:debug": "tsx watch --inspect=0.0.0.0:9229 src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "clean": "rm -rf dist checkpoints.sqlite",
    "test:agent": "tsx --env-file=.env test-agent.ts",
    "docker:up": "docker-compose up --build",
    "docker:up:detach": "docker-compose up -d --build",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker-compose -f docker-compose.prod.yml down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.3.0",
    "@langchain/anthropic": "^1.3.3",
    "@langchain/core": "^1.1.8",
    "@langchain/langgraph": "^1.0.7",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.0",
    "@langchain/openai": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@types/form-data": "^2.2.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "canvas": "^3.2.1",
    "fastify": "^5.6.2",
    "form-data": "^4.0.5",
    "openai": "^6.16.0",
    "pdf-to-img": "^5.0.0",
    "redis": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
