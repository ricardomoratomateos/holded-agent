# Anthropic API (obligatoria para Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API (obligatoria para visión de documentos)
OPENAI_API_KEY=sk-...

# Google API (opcional, para Gemini models)
GOOGLE_API_KEY=AIza...

# Qdrant (vector database para memoria)
# Local: http://localhost:6333 | Docker: http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY= # Opcional si usas Qdrant Cloud

# LangSmith (opcional, para trazas y debugging)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT="holded-agent"

# Brave Search (opcional, para búsqueda web)
BRAVE_SEARCH_API_KEY=BS...

# SQLite path (para Docker)
SQLITE_PATH=/app/data/checkpoints.sqlite

# Redis (para cache semántica de documentación)
# Local: redis://:tu_password@localhost:6379
# Docker: redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=tu_password_segura_aqui